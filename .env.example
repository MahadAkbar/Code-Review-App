PORT=3000
APP_BASE_URL=http://localhost:3000

# Optional GitHub OAuth app settings for private repos and higher API limits
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Choose the active review provider: openai or groq
LLM_PROVIDER=groq

# OpenAI review provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# GroqCloud review provider
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
